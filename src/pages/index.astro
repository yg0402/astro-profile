---
// 名前・自己紹介・スキル・リンクはここで編集できます。
const profile = {
  name: '山田 太郎',
  englishName: 'Taro Yamada',
  role: 'Web Developer / Tokyo, Japan',
  introduction: '日々の「ちょっと便利」を、つくる。',
  description: '東京を拠点に、Webサイトや小さなアプリをつくっています。シンプルで使いやすく、心地よいものづくりが好きです。',
  about: 'Webの技術を学びながら、アイデアを少しずつ形にしています。見た目の美しさだけでなく、使う人にとってのわかりやすさを大切にしています。',
  interests: '休日はコーヒーを片手に読書をしたり、街を歩いて新しいお店を探したり。つくることも、日常の小さな発見も楽しんでいます。',
  avatar: 'avatar.svg',
};
const skills = ['HTML / CSS', 'JavaScript', 'TypeScript', 'Astro', 'Git / GitHub'];
// ダミーのリンクです。公開前に自分のURL・メールアドレスに変更してください。
const links = [
  { label: 'GitHub', detail: 'コード・制作物', href: 'https://github.com/example' },
  { label: 'X', detail: '日々のこと', href: 'https://x.com/example' },
  { label: 'Email', detail: 'お問い合わせ', href: 'mailto:hello@example.com' },
];
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${profile.name}のプロフィール。${profile.description}`} />
    <meta name="theme-color" content="#f8f9f6" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{profile.name} | プロフィール</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <div class="page">
      <header>
        <a class="brand" href={base} aria-label="プロフィールのトップへ">TY<span class="brand-dot">.</span></a>
        <nav aria-label="ページ内ナビゲーション">
          <a href="#about">About</a>
          <a href="#skills">Skills</a>
          <a href="#links">Links</a>
        </nav>
      </header>

      <main id="main">
        <section class="hero" aria-labelledby="profile-heading">
          <div class="portrait">
            <img src={`${base}${profile.avatar}`} width="144" height="144" alt="プロフィール画像のプレースホルダー" />
          </div>
          <p class="eyebrow">こんにちは、はじめまして。</p>
          <h1 id="profile-heading">{profile.name}<span>{profile.englishName}</span></h1>
          <p class="role">{profile.role}</p>
          <h2 class="tagline">{profile.introduction}</h2>
          <p class="intro">{profile.description}</p>
          <a class="contact" href="#links">つながる <span aria-hidden="true">↗</span></a>
        </section>

        <section class="content-section" id="about" aria-labelledby="about-heading">
          <div class="section-heading"><span class="number" aria-hidden="true">01</span><h2 id="about-heading">About<span>私について</span></h2></div>
          <div class="section-body about-text"><p>{profile.about}</p><p>{profile.interests}</p></div>
        </section>

        <section class="content-section" id="skills" aria-labelledby="skills-heading">
          <div class="section-heading"><span class="number" aria-hidden="true">02</span><h2 id="skills-heading">Skills<span>できること・学んでいること</span></h2></div>
          <div class="section-body"><ul class="skills">{skills.map((skill) => <li>{skill}</li>)}</ul><p class="note">少しずつ、できることを増やしています。</p></div>
        </section>

        <section class="content-section" id="links" aria-labelledby="links-heading">
          <div class="section-heading"><span class="number" aria-hidden="true">03</span><h2 id="links-heading">Links<span>つながる</span></h2></div>
          <div class="section-body">
            <p class="links-intro">制作物や日々のことはこちらから。<br />お気軽にご連絡ください。</p>
            <ul class="links">{links.map((link) => (
              <li><a href={link.href} target={link.href.startsWith('https:') ? '_blank' : undefined} rel={link.href.startsWith('https:') ? 'noopener noreferrer' : undefined}>
                <span><strong>{link.label}</strong><span class="link-detail">{link.detail}</span></span>
                <span class="arrow" aria-hidden="true">↗</span>
                {link.href.startsWith('https:') && <span class="sr-only">（新しいタブで開きます）</span>}
              </a></li>
            ))}</ul>
          </div>
        </section>
      </main>

      <footer><p>© {year} {profile.englishName}</p><p>つくることを、楽しもう。</p></footer>
    </div>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #f8f9f6; scroll-padding-top: 28px; }
  :global(body) { margin: 0; color: #263a31; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Kaku Gothic ProN", "Noto Sans JP", Meiryo, sans-serif; line-height: 1.9; -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(a:focus-visible) { outline: 3px solid #285b47; outline-offset: 5px; }
  :global(p), :global(h1), :global(h2) { margin: 0; }
  :global(ul) { list-style: none; margin: 0; padding: 0; }
  :global(::selection) { background: #dbe8de; }
  .page { max-width: 888px; margin: 0 auto; padding: 0 36px; }
  header { display: flex; justify-content: space-between; align-items: center; padding: 28px 0; border-bottom: 1px solid #dde3dc; }
  .brand { font-size: 24px; font-weight: 750; letter-spacing: -1px; line-height: 1.5; }
  .brand-dot { color: #528369; }
  nav { display: flex; gap: 26px; font-size: 13px; font-weight: 500; }
  nav a { padding: 6px 0; }
  nav a:hover { color: #285b47; text-decoration: underline; text-underline-offset: 6px; }
  .hero { padding: 72px 0 76px; max-width: 640px; }
  .portrait { margin-bottom: 26px; }
  .portrait img { display: block; width: 112px; height: 112px; border-radius: 50%; object-fit: cover; border: 5px solid #fff; }
  .eyebrow { color: #52665b; font-size: 13px; letter-spacing: .08em; margin-bottom: 10px; }
  h1 { font-size: clamp(30px, 5vw, 42px); line-height: 1.4; font-weight: 700; letter-spacing: .06em; }
  h1 span { display: block; font-size: 13px; font-weight: 400; letter-spacing: .12em; color: #52665b; margin-top: 7px; }
  .role { margin-top: 16px; color: #52665b; font-size: 12px; letter-spacing: .04em; }
  .tagline { margin-top: 34px; font-size: clamp(19px, 3.8vw, 24px); font-weight: 600; letter-spacing: .015em; line-height: 1.7; }
  .intro { margin-top: 14px; max-width: 520px; font-size: 14px; color: #526057; line-height: 2; }
  .contact { display: inline-flex; align-items: center; gap: 36px; background: #285b47; color: #fff; margin-top: 28px; padding: 11px 21px; border-radius: 6px; font-size: 13px; }
  .contact:hover { background: #1e4737; }
  .content-section { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 32px; padding: 40px 0; border-top: 1px solid #dde3dc; }
  .section-heading { display: flex; gap: 14px; align-items: baseline; }
  .number { color: #64776c; font-size: 10px; font-variant-numeric: tabular-nums; }
  .section-heading h2 { font-size: 22px; font-weight: 600; line-height: 1.5; letter-spacing: -.02em; }
  .section-heading h2 span { display: block; font-size: 11px; color: #52665b; font-weight: 400; margin-top: 8px; letter-spacing: 0; }
  .section-body { padding-top: 3px; }
  .about-text { color: #526057; font-size: 14px; line-height: 2; }
  .about-text p + p { margin-top: 16px; }
  .skills { display: flex; flex-wrap: wrap; gap: 9px; }
  .skills li { padding: 5px 13px; border: 1px solid #dce3da; border-radius: 5px; font-size: 12px; background: #fff; }
  .note { color: #52665b; font-size: 11px; margin-top: 16px; }
  .links-intro { font-size: 13px; color: #526057; margin-bottom: 20px; }
  .links { display: grid; gap: 10px; }
  .links a { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 15px 18px; border: 1px solid #dce3da; border-radius: 6px; background: #fff; }
  .links a:hover { border-color: #789785; background: #f0f5ef; }
  .links strong { font-size: 13px; font-weight: 600; }
  .link-detail { margin-left: 16px; color: #52665b; font-size: 11px; }
  .arrow { color: #285b47; font-size: 18px; line-height: 1; }
  footer { display: flex; justify-content: space-between; gap: 16px; padding: 24px 0 32px; margin-top: 20px; border-top: 1px solid #dde3dc; font-size: 10px; color: #52665b; }
  .skip-link { position: absolute; top: 8px; left: 8px; padding: 8px 16px; background: #fff; z-index: 1; transform: translateY(-150%); }
  .skip-link:focus { transform: translateY(0); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 640px) {
    .page { padding: 0 24px; }
    header { padding: 22px 0; }
    nav { gap: 18px; font-size: 12px; }
    .hero { padding: 48px 0; }
    .content-section { grid-template-columns: minmax(0, 1fr); gap: 22px; padding: 32px 0; }
    .section-heading h2 span { margin-top: 4px; }
    footer { flex-wrap: wrap; margin-top: 12px; }
  }
</style>
